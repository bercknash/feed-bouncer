{
  "manifest_version": 3,
  "name": "FB AI Ad Blocker",
  "version": "0.2.0",
  "description": "Hides Facebook ads instantly using the feed's own sponsored-post data, with a rendered-label and LLM fallback.",
  "minimum_chrome_version": "138",
  "permissions": ["storage", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "FB AI Ad Blocker" },
  "options_page": "options.html"
}
